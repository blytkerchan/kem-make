KEM-MAKE-2026 DEFINITIONS IMPLICIT TAGS ::=
BEGIN

-- ===========================================================================
-- KEM-MAKE protocol message syntax.
--
-- Encoding: DER only. BER (indefinite lengths, non-minimal length forms,
-- non-canonical constructed/primitive forms) is not permitted on the wire.
-- ===========================================================================

-- Standard PKIX AlgorithmIdentifier (RFC 5280), reused here for both KEM
-- algorithms and digest algorithms.
AlgorithmIdentifier ::= SEQUENCE {
    algorithm   OBJECT IDENTIFIER,
    parameters  ANY DEFINED BY algorithm OPTIONAL
}

-- ML-KEM OIDs (RFC 9935). parameters MUST be
-- absent for all three; not NULL.
id-alg-ml-kem-512  OBJECT IDENTIFIER ::= { 2 16 840 1 101 3 4 4 1 }
id-alg-ml-kem-768  OBJECT IDENTIFIER ::= { 2 16 840 1 101 3 4 4 2 }
id-alg-ml-kem-1024 OBJECT IDENTIFIER ::= { 2 16 840 1 101 3 4 4 3 }

KemPublicKey ::= SEQUENCE {
    algorithm   AlgorithmIdentifier,   -- one of id-alg-ml-kem-{512,768,1024}
    publicKey   OCTET STRING           -- length fixed by algorithm (FIPS 203)
}

KemCiphertext ::= SEQUENCE {
    algorithm   AlgorithmIdentifier,   -- one of id-alg-ml-kem-{512,768,1024}
    ciphertext  OCTET STRING           -- length fixed by algorithm (FIPS 203)
}

-- Key identifier: digest algorithm + hash of the DER encoding of the whole
-- KemPublicKey SEQUENCE (algorithm + key bytes), never the raw key octets
-- alone. hashAlgorithm identifies how keyHash was computed; it says nothing
-- about the KEM algorithm of the underlying key.
KeyId ::= SEQUENCE {
    hashAlgorithm  AlgorithmIdentifier,
    keyHash        OCTET STRING
}

-- === section ===
-- MAKE protocol PDUs
-- === section ===

-- AEAD algorithm OIDs used for negotiation only: a bare OBJECT IDENTIFIER,
-- not a full AlgorithmIdentifier. AES-GCM (RFC 5084) normally requires a
-- present parameters field with actual nonce/ICV-length data when used as
-- a real AlgorithmIdentifier for encryption; that requirement does not
-- apply here, since these fields only carry the OID for capability
-- negotiation, analogous to how RFC 8103 defines SMIMECapability
-- announcement (OID only, parameters omitted).
id-aes128-gcm           OBJECT IDENTIFIER ::= { 2 16 840 1 101 3 4 1 6 }
id-aes192-gcm           OBJECT IDENTIFIER ::= { 2 16 840 1 101 3 4 1 26 }
id-aes256-gcm           OBJECT IDENTIFIER ::= { 2 16 840 1 101 3 4 1 46 }
id-chacha20-poly1305    OBJECT IDENTIFIER ::= { 1 2 840 113549 1 9 16 3 18 }

AcceptableAeadList ::= SEQUENCE OF OBJECT IDENTIFIER

SessionInitRequest ::= SEQUENCE {
    ct1               KemCiphertext,
    pkAStar           KemPublicKey,
    keyIdA            KeyId,
    acceptableAeads   AcceptableAeadList
}

SessionInitResponse ::= SEQUENCE {
    keyIdB      KeyId,
    pkBStar     KemPublicKey,
    ct2         KemCiphertext,
    ct3         KemCiphertext,
    nB          OCTET STRING,
    chosenAead  OBJECT IDENTIFIER
}

SessionCompletionRequest ::= SEQUENCE {
    cM          OCTET STRING,
    ct4         KemCiphertext,
    nA          OCTET STRING,
    m       [0] OCTET STRING OPTIONAL
}

SessionCompletionResponse ::= SEQUENCE {
    hM          OCTET STRING,
    m       [0] OCTET STRING OPTIONAL
}

-- seq is scoped per direction: each peer keeps its own independent
-- counter, so the same seq value can legitimately appear once from each
-- peer within a session. This is safe because each direction has its own
-- independently derived session key (from the same HKDF that produces
-- the other session key material); the pair (direction key, seq) is what
-- must be unique, not seq alone.
Message ::= SEQUENCE {
    seq  INTEGER,
    m    OCTET STRING
}

MakePayload ::= CHOICE {
    sessionInitRequest        [0] SessionInitRequest,
    sessionInitResponse       [1] SessionInitResponse,
    sessionCompletionRequest  [2] SessionCompletionRequest,
    sessionCompletionResponse [3] SessionCompletionResponse,
    message                   [4] Message
}

-- Versioned session envelope. version defaults to 0 (protocol v1) and, per
-- DER, MUST be omitted from the encoding when equal to its default value.
-- cid is a 128-bit binary UUID (RFC 4122), fixed length, no ASN.1-level
-- length constraint expressed here beyond OCTET STRING; length is
-- enforced by the implementation, not the schema.
MakeMessage ::= SEQUENCE {
    version  INTEGER DEFAULT 0,
    cid      OCTET STRING (SIZE(16)),  -- 128-bit UUID (RFC 4122)
    payload  MakePayload
}

END
